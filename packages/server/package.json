{
  "name": "@gladiator/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The authoritative server: tick scheduler, rooms, WebSocket transport.",
  "dependencies": {
    "@gladiator/bot": "workspace:*",
    "@gladiator/sim": "workspace:*",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:ws --outfile=dist/index.js",
    "typecheck": "tsc -p tsconfig.json"
  }
}
