{
  "name": "gladiator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Gladiator — a browser-native Rocket Arena duel.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r run build",
    "guardrails": "node scripts/guardrails.mjs",
    "no-physics": "node scripts/no-physics-plugin.mjs",
    "e2e": "node scripts/e2e.mjs",
    "raw-input": "node scripts/raw-input.mjs",
    "map:bake": "tsx tools/bake-map.ts",
    "nav:bake": "tsx tools/nav-bake.ts",
    "bot:soak": "tsx tools/bot-soak.ts",
    "audio:bake": "tsx tools/synth-audio.ts",
    "lightmap:bake": "tsx tools/bake-lightmap.ts",
    "audio:verify": "node scripts/audio-check.mjs",
    "demo": "pnpm --filter @gladiator/server run demo",
    "latency": "tsx tools/latency-harness.ts",
    "assets:build": "tsx tools/assets-build.ts",
    "assets:budget": "tsx tools/assets-budget.ts",
    "assets:vendor": "tsx tools/assets-vendor.ts",
    "assets:placeholders": "tsx tools/assets-placeholders.ts",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build && pnpm run no-physics && pnpm run guardrails && pnpm run assets:budget && pnpm run latency"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gladiator/bot": "workspace:*",
    "@gladiator/sim": "workspace:*",
    "@gltf-transform/core": "4.4.2",
    "@gltf-transform/extensions": "4.4.2",
    "@types/node": "22.20.1",
    "@types/pngjs": "6.0.5",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "ktx-parse": "1.1.0",
    "ktx2-encoder": "0.6.0",
    "meshoptimizer": "1.2.0",
    "playwright": "1.62.1",
    "pngjs": "7.0.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
