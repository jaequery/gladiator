{
  "name": "gladiator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Gladiator — a browser-native Rocket Arena duel.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r run build",
    "guardrails": "node scripts/guardrails.mjs",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build && pnpm run guardrails"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
